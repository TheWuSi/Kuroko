# Kuroko 环境变量配置

# Docker 对外端口（容器内部固定监听 8000）
BACKEND_PORT=8000

# JWT 密钥（生产环境必须修改为随机长字符串）
KUROKO_SECRET_KEY=change-me-in-production
KUROKO_ENVIRONMENT=development
KUROKO_PORT=8000
KUROKO_DATABASE_URL=sqlite:///./data/kuroko.db
KUROKO_TASK_POLL_SECONDS=30
KUROKO_CORS_ORIGINS=http://localhost:5173

# 可选：本地目录覆盖（Docker 中已映射到 /app 下对应目录）
# KUROKO_CONFIG_DIR=./config
# KUROKO_DATA_DIR=./data
# KUROKO_LOG_DIR=./logs

# 可选：前端开发服务器地址
# VITE_API_BASE_URL=http://localhost:8000/api/v1
