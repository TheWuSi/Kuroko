# Kuroko 环境变量配置

# Docker 对外端口（容器内部固定监听 8000）
BACKEND_PORT=8000

# JWT 密钥（生产环境必须修改为随机长字符串）
KUROKO_SECRET_KEY=change-me-in-production
KUROKO_ENVIRONMENT=production
KUROKO_PORT=8000
KUROKO_DATABASE_URL=sqlite:///./data/kuroko.db
KUROKO_TASK_POLL_SECONDS=30
KUROKO_CORS_ORIGINS=http://localhost:8000

# OpenList v4.2.6 地址；账号/令牌通过系统设置保存
OPENLIST_BASE_URL=
# 本地直接启动后端时可改用 KUROKO_OPENLIST_BASE_URL

# Docker 内使用服务名；本地启动后端时配置 http://127.0.0.1:8080
BT_PARSER_SERVICE_URL=http://magnet-metadata-api:8080
METADATA_API_IMAGE=felipemarinho97/magnet-metadata-api:0.1.0
METADATA_API_PORT=8080
# DHT/Peer 入站端口，TCP 与 UDP 均映射到相同容器端口
METADATA_CLIENT_PORT=42069
METADATA_CACHE_DIR=./data/metadata
REDIS_DATA_DIR=./data/redis

# 可选：本地目录覆盖（Docker 中已映射到 /app 下对应目录）
# KUROKO_CONFIG_DIR=./config
# KUROKO_DATA_DIR=./data
# KUROKO_LOG_DIR=./logs

# 可选：前端开发服务器地址
# VITE_API_BASE_URL=http://localhost:8000/api/v1
